# LF everywhere: shell scripts run in the Linux container, and the FASTA/FASTQ/JSON test inputs
# must be byte-identical on every OS (Windows CI included).
* text=auto eol=lf
*.sh text eol=lf
Dockerfile text eol=lf

# Binary data
*.gz binary
*.npy binary
*.npz binary
*.png binary
*.pdf binary

# Generated files: collapsed in GitHub diffs, excluded from language statistics
tests/reference/data/** linguist-generated
src/pydada2/_core.pyi linguist-generated
uv.lock linguist-generated
